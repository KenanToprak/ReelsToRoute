# Database connection string (PostgreSQL or SQLite for local testing)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/reels_route_db

# JWT signing configuration
SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Google Gemini API key (leave empty to use built-in mock AI responses)
GEMINI_API_KEY=

# Comma-separated or JSON list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
